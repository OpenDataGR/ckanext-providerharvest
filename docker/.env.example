# Copy this file to `.env` (same directory) before running
# `docker compose up`. Values below are safe *local/dev-only* defaults --
# see README.md's "Local Docker replica" section for how this is used and
# what still needs changing before anything resembling this ever runs
# somewhere reachable by anyone but you.
#
# None of the passwords/secrets below are real secrets: they're fixed
# placeholder values checked into git on purpose, so `docker compose up`
# reproduces the exact same replica for anyone from a fresh clone. Rotate
# every one of them before this compose file is ever adapted for anything
# beyond a disposable local replica.

# --- Host ports -------------------------------------------------------
CKAN_PORT_HOST=5000
SOLR_PORT_HOST=8983

# --- CKAN core ----------------------------------------------------------
CKAN_VERSION=2.11.3
CKAN_SITE_ID=default
CKAN_SITE_URL=http://localhost:5000
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME_LOCAL_DEV_ONLY
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:CHANGE_ME_LOCAL_DEV_ONLY
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:CHANGE_ME_LOCAL_DEV_ONLY
# Flask's own SECRET_KEY (CKAN 2.10+ requires this set explicitly --
# beaker.session.secret above no longer doubles as a fallback for it).
# The running web app tolerates it being unset for plain API calls, but
# every `ckan <command>` CLI invocation aborts immediately with
# "Invalid configuration values provided: SECRET_KEY: Missing value" --
# which silently broke ckan-worker's sysadmin creation, the harvest
# queue consumers, and the xloader jobs worker, since all of them go
# through the CLI.
CKAN___SECRET_KEY=CHANGE_ME_LOCAL_DEV_ONLY
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=test1234pass
CKAN_SYSADMIN_EMAIL=admin@example.com
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_MAX_UPLOAD_SIZE_MB=100
TZ=UTC

# --- Postgres / DataStore -------------------------------------------------
# ckanext-datastore needs two roles: CKAN_DB_USER (full access, owns both
# databases) and DATASTORE_READONLY_USER (NOCREATEDB/NOCREATEROLE, used
# for datastore_search[_sql] queries -- see
# docker/postgresql/docker-entrypoint-initdb.d/20_create_datastore.sh).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=ckandbpassword
CKAN_DB=ckandb
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=datastore
DATASTORE_DB=datastore
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:ckandbpassword@db/ckandb
CKAN__DATASTORE__WRITE_URL=postgresql://ckandbuser:ckandbpassword@db/datastore
CKAN__DATASTORE__READ_URL=postgresql://datastore_ro:datastore@db/datastore

# --- Solr -----------------------------------------------------------------
SOLR_IMAGE_VERSION=2.11-solr9
CKAN_SOLR_URL=http://solr:8983/solr/ckan

# --- Redis (ckanext-harvest's queue + CKAN's own RQ background jobs) ------
REDIS_VERSION=7-alpine
CKAN__REDIS__URL=redis://redis:6379/1
CKAN__HARVEST__MQ__TYPE=redis
CKAN__HARVEST__MQ__HOSTNAME=redis
CKAN__HARVEST__MQ__PORT=6379
CKAN__HARVEST__MQ__REDIS_DB=1

# --- Mock provider (end-to-end harvest-job integration test only) ---------
MOCK_PROVIDER_PYTHON_VERSION=3.12-alpine

# --- Extensions: harvest, datastore, xloader, scheming_datasets, dcat -----
# providerharvest is listed last, after harvest and datastore, per
# README.md's install instructions. datatables_view/text_view/image_view
# are stock CKAN view plugins, included so resource previews (including
# the DataStore grid view providerharvest relies on to "show" pulled
# data) render out of the box.
CKAN__PLUGINS=envvars image_view text_view datatables_view datastore harvest xloader scheming_datasets fluent dcat providerharvest

# ckanext-scheming: the `ckan_dataset.yaml` shipped with ckanext-scheming
# itself is a stand-in for data.gov.gr's real DCAT-AP-EL schema (see
# DESIGN.md's "Open Questions" -- the real schema needs confirming with
# the contractor); it mirrors stock CKAN fields so the replica boots with
# a working `scheming_datasets` schema without guessing at that schema.
CKAN___SCHEMING__DATASET_SCHEMAS=ckanext.scheming:ckan_dataset.yaml
CKAN___SCHEMING__PRESETS=ckanext.scheming:presets.json ckanext.fluent:presets.json

# ckanext-xloader: `ckanext.xloader.api_token` itself is generated at
# container start by docker/ckan/worker-entrypoint.sh (it depends on a
# sysadmin user that only exists once the DB has been initialized), not
# set here.
CKAN__XLOADER__JOBS_DB__URI=postgresql://ckandbuser:ckandbpassword@db/ckandb

# How often the ckan-worker container calls `ckan harvester run` to start
# any due harvest jobs -- ckanext-harvest's own docs suggest a cron entry
# every 15 minutes in production; a short interval here just makes local
# verification faster.
HARVEST_RUN_INTERVAL_SECONDS=60

# --- ckanext-providerharvest --------------------------------------------
# Envelope-encryption master key (AES-256-GCM KEK), base64-encoded 32
# random bytes, per README.md step 3. This placeholder is NOT a real
# secret -- generate your own before this ever stores a real credential:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CKAN_PROVIDERHARVEST_MASTER_KEY=zH2s6vQKZ+bT2b0m1zXQ8h7vQwq2b8bQY5X1jV0m8pE=
